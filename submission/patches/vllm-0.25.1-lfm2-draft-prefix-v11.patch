+@triton.jit
+def _draft_conv_qlen12_kernel(
+    x,
+    state,
+    weight,
+    bias,
+    query_start_loc,
+    state_indices,
+    output,
+    stride_x_token: tl.constexpr,
+    stride_x_dim: tl.constexpr,
+    stride_state_slot: tl.constexpr,
+    stride_state_dim: tl.constexpr,
+    stride_state_token: tl.constexpr,
+    stride_weight_dim: tl.constexpr,
+    stride_weight_token: tl.constexpr,
+    stride_state_indices: tl.constexpr,
+    stride_output_token: tl.constexpr,
+    stride_output_dim: tl.constexpr,
+    dim: tl.constexpr,
+    BLOCK: tl.constexpr,
+    HAS_BIAS: tl.constexpr,
+):
+    request = tl.program_id(0)
+    channels = tl.program_id(1) * BLOCK + tl.arange(0, BLOCK)
+    mask = channels < dim
+    start = tl.load(query_start_loc + request)
+    end = tl.load(query_start_loc + request + 1)
+    qlen = end - start
+    slot = tl.load(state_indices + request * stride_state_indices)
+
+    state_base = (
+        state
+        + slot * stride_state_slot
+        + channels * stride_state_dim
+    )
+    s0 = tl.load(state_base, mask=mask, other=0.0)
+    s1 = tl.load(state_base + stride_state_token, mask=mask, other=0.0)
+    t0 = tl.load(
+        x + start * stride_x_token + channels * stride_x_dim,
+        mask=mask,
+        other=0.0,
+    )
+    weight_base = weight + channels * stride_weight_dim
+    w0 = tl.load(weight_base, mask=mask, other=0.0)
+    w1 = tl.load(weight_base + stride_weight_token, mask=mask, other=0.0)
+    w2 = tl.load(weight_base + 2 * stride_weight_token, mask=mask, other=0.0)
+    acc0 = tl.zeros((BLOCK,), dtype=tl.float32)
+    if HAS_BIAS:
+        acc0 = tl.load(bias + channels, mask=mask, other=0.0).to(tl.float32)
+    acc0 += s0 * w0
+    acc0 += s1 * w1
+    acc0 += t0 * w2
+    tl.store(
+        output + start * stride_output_token + channels * stride_output_dim,
+        acc0,
+        mask=mask,
+    )
+
+    if qlen == 2:
+        t1 = tl.load(
+            x + (start + 1) * stride_x_token + channels * stride_x_dim,
+            mask=mask,
+            other=0.0,
+        )
+        acc1 = tl.zeros((BLOCK,), dtype=tl.float32)
+        if HAS_BIAS:
+            acc1 = tl.load(bias + channels, mask=mask, other=0.0).to(tl.float32)
+        acc1 += s1 * w0
+        acc1 += t0 * w1
+        acc1 += t1 * w2
+        tl.store(
+            output
+            + (start + 1) * stride_output_token
+            + channels * stride_output_dim,
+            acc1,
+            mask=mask,
+        )
+        tl.store(state_base, t0, mask=mask)
+        tl.store(state_base + stride_state_token, t1, mask=mask)
+    else:
+        tl.store(state_base, s1, mask=mask)
+        tl.store(state_base + stride_state_token, t0, mask=mask)
+
+
+def specialized_draft_conv_replay(
+    x: torch.Tensor,
+    conv_state: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    state_indices: torch.Tensor,
+    query_start_loc: torch.Tensor,
+) -> torch.Tensor:
+    assert conv_state.shape[-1] == 2 and weight.shape[-1] == 3
+    output = torch.empty_like(x)
+    batch_size = query_start_loc.numel() - 1
+    grid = (batch_size, triton.cdiv(x.shape[1], 256))
+    _draft_conv_qlen12_kernel[grid](
+        x,
+        conv_state,
+        weight,
+        bias,
+        query_start_loc,
+        state_indices[:, 0],
+        output,
+        x.stride(0),
+        x.stride(1),
+        conv_state.stride(0),
+        conv_state.stride(1),
+        conv_state.stride(2),
+        weight.stride(0),
+        weight.stride(1),
+        state_indices.stride(0),
+        output.stride(0),
+        output.stride(1),
+        dim=x.shape[1],
+        BLOCK=256,
+        HAS_BIAS=bias is not None,
+    )
+    return output
+
+
+def materialized_draft_conv_replay(
+    x: torch.Tensor,
+    conv_state: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    state_indices: torch.Tensor,
+    query_start_loc: torch.Tensor,
+) -> torch.Tensor:
+    """Replay committed draft rows without aliasing persistent conv state."""
+    state_len = conv_state.shape[-1]
+    query_lens = torch.diff(query_start_loc)
+    batch_size = query_lens.numel()
+    num_tokens = x.shape[0]
+    device = x.device
+
+    request_ids = torch.arange(batch_size, device=device, dtype=torch.long)
+    token_request_ids = torch.repeat_interleave(
+        request_ids, query_lens.to(torch.long)
+    )
+    token_offsets = torch.arange(num_tokens, device=device) - query_start_loc[
+        :-1
+    ].to(torch.long).index_select(0, token_request_ids)
+
+    max_query_len = state_indices.shape[1]
+    dense = torch.zeros(
+        (batch_size, x.shape[1], state_len + max_query_len),
+        dtype=x.dtype,
+        device=device,
+    )
+    persistent_slots = state_indices[:, 0].to(torch.long)
+    dense[:, :, :state_len].copy_(
+        conv_state.index_select(0, persistent_slots)
+    )
+    dense[
+        token_request_ids, :, state_len + token_offsets
+    ] = x
+
+    dense_output = F.conv1d(
+        dense,
+        weight.unsqueeze(1),
+        bias,
+        groups=x.shape[1],
+    ).transpose(1, 2)
+    real_output = dense_output[token_request_ids, token_offsets]
+
+    tail_offsets = query_lens.to(torch.long).unsqueeze(1) + torch.arange(
+        state_len, device=device
+    )
+    new_state = dense.transpose(1, 2)[
+        request_ids.unsqueeze(1), tail_offsets
+    ].transpose(1, 2)
+    conv_state.index_copy_(
+        0, persistent_slots, new_state.to(conv_state.dtype)
+    )
+    return real_output
+
+
+def batched_draft_conv_replay(
+    x: torch.Tensor,
+    conv_state: torch.Tensor,
+    weight: torch.Tensor,
+    bias: torch.Tensor | None,
+    state_indices: torch.Tensor,
+    query_start_loc: torch.Tensor,
+) -> torch.Tensor:
+    """Replay qlen-1/2 draft rows in at most two ordinary update calls."""
+    query_lens = torch.diff(query_start_loc)
+    batch_size = query_lens.numel()
+    first_token_indices = query_start_loc[:-1].to(torch.long)
+    persistent_slots = state_indices[:, 0]
+    first_output = causal_conv1d_update(
+        x.index_select(0, first_token_indices),
+        conv_state,
+        weight,
+        bias,
+        activation=None,
+        conv_state_indices=persistent_slots,
+    )
+
+    has_second = query_lens == 2
+    second_token_indices = first_token_indices + has_second.to(torch.long)
+    second_slots = torch.where(
+        has_second, persistent_slots, torch.zeros_like(persistent_slots)
+    )
+    second_output = causal_conv1d_update(
+        x.index_select(0, second_token_indices),
+        conv_state,
+        weight,
+        bias,
+        activation=None,
+        conv_state_indices=second_slots,
+    )
+
+    request_ids = torch.arange(batch_size, device=x.device, dtype=torch.long)
+    token_request_ids = torch.repeat_interleave(
+        request_ids, query_lens.to(torch.long)
+    )
+    token_offsets = torch.arange(x.shape[0], device=x.device) - (
+        first_token_indices.index_select(0, token_request_ids)
+    )
+    per_request_output = torch.stack((first_output, second_output), dim=1)
+    return per_request_output[token_request_ids, token_offsets]
+
