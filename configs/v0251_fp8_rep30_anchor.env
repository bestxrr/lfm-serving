MODEL=LiquidAI/LFM2.5-1.2B-Instruct
SERVED_MODEL_NAME=LFM2.5-1.2B-Instruct
HOST=127.0.0.1
PORT=8010
MAX_MODEL_LEN=5120
GPU_MEM_UTIL=0.10
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=512
ENABLE_PREFIX_CACHING=1
QUANTIZATION=fp8_per_tensor
PREFIX_CACHE_HASH_ALGO=xxhash
DISABLE_LOG_STATS=0
DISABLE_ACCESS_LOG=1
CPU_PIN=0-2
VRAM_LIMIT_MIB=10000
MIN_FREE_VRAM_MIB=11000
VLLM_VENV=.venv-v0251-clean
HF_HOME=/data/nvidia-lab/lfm-serving/.hf_home
VLLM_USE_FLASHINFER_SAMPLER=0
SELF_WARMUP=1
CPATH=/data/nvidia-lab/lfm-serving/.local-python-dev/extract/usr/include/python3.12:/data/nvidia-lab/lfm-serving/.local-python-dev/extract/usr/include
LD_LIBRARY_PATH=/data/nvidia-lab/lfm-serving/.local-cuda-compat/extract/usr/local/cuda-13.0/compat
CUDA_MODULE_LOADING=LAZY
EXTRA_VLLM_ARGS="--no-async-scheduling"
